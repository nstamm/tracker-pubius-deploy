{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "hostinger-vps": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx.cmd",
        "--package=hostinger-api-mcp@latest",
        "hostinger-vps-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "hostinger-dns": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx.cmd",
        "--package=hostinger-api-mcp@latest",
        "hostinger-dns-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
