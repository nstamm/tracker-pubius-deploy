# Generate with: npm run auth:hash -- "your-password"
# Keep the hash single-quoted so Docker Compose preserves its $ characters.
AUTH_EMAIL=owner@example.com
AUTH_PASSWORD_HASH='scrypt$16384$8$1$replace-with-generated-hash'
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=

APP_DOMAIN=tracker.pubiusmarketing.com
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7

# Monthly email report (all required to enable; leave empty to disable)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@pubiusmarketing.com
SMTP_PASSWORD=replace-with-smtp-password
REPORT_RECIPIENT=info@pubiusmarketing.com
# REPORT_FROM=info@pubiusmarketing.com
# REPORT_TIMEZONE=America/Argentina/Buenos_Aires
# REPORT_HOUR=8
